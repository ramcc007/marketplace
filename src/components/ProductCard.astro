---
import type { Product } from '../lib/catalog';
import { startingPriceLabel } from '../lib/catalog';
import { formatDate } from '../lib/dates';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { data } = product;
---

<li class="group relative rounded-xl border border-slate-200 bg-white p-5 shadow-card transition hover:border-brand-600">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-base font-semibold text-slate-900">
      <a href={`/products/${product.id}`} class="after:absolute after:inset-0 after:content-[''] group-hover:text-brand-700">
        {data.name}
      </a>
    </h3>
    {data.status === 'draft' && <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-900">Draft</span>}
  </div>
  <p class="text-sm text-slate-500">{data.vendor.name}</p>
  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-700">{data.summary}</p>
  <dl class="mt-4 grid gap-x-6 gap-y-1 border-t border-slate-100 pt-3 text-sm sm:grid-cols-[auto_auto_auto]">
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">From</dt>
      <dd class="font-medium text-slate-900">{startingPriceLabel(product)}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Free plan</dt>
      <dd class="font-medium text-slate-900">{data.pricing.freePlan ? 'Yes' : 'No'}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Prices checked</dt>
      <dd class="font-medium text-slate-900">{formatDate(data.pricing.verifiedAt)}</dd>
    </div>
  </dl>
</li>
