---
import type { Product } from '../lib/catalog';
import { startingBaseFeeUsd, startingListedPrice, startingMonthlyUsd, startingVolumeFee } from '../lib/catalog';
import { formatDate, formatMoney, formatUsd, formatVolumeFee } from '../lib/dates';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { data } = product;
const start = startingMonthlyUsd(product);
const listed = start === null ? startingListedPrice(product) : null;
const baseFee = startingBaseFeeUsd(product);
// A plan priced only as a share of revenue is the real entry point, even when a flat-fee plan also exists.
const volumeFee = startingVolumeFee(product);
---

<li class="rounded-lg border border-slate-200 p-4">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <a href={`/products/${product.id}`} class="text-base font-semibold text-slate-900 hover:text-teal-700">{data.name}</a>
    {data.status === 'draft' && <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-900">Draft</span>}
  </div>
  <p class="mt-1 text-sm text-slate-500">{data.vendor.name}</p>
  <p class="mt-3 text-sm text-slate-700">{data.summary}</p>
  <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <div>
      <dt class="inline text-slate-500">From</dt>
      <dd class="ml-1 inline font-medium">
        {volumeFee
          ? formatVolumeFee(volumeFee)
          : start !== null
            ? `${formatUsd(start)} a month${baseFee ? ` plus a ${formatUsd(baseFee)} monthly base fee` : ''}`
            : listed
              ? `${formatMoney(listed.amount, listed.currency)} a month`
              : data.pricing.model === 'free'
              ? 'Free'
              : 'Price on request'}
      </dd>
    </div>
    <div>
      <dt class="inline text-slate-500">Free plan</dt>
      <dd class="ml-1 inline font-medium">{data.pricing.freePlan ? 'Yes' : 'No'}</dd>
    </div>
    <div>
      <dt class="inline text-slate-500">Prices checked</dt>
      <dd class="ml-1 inline font-medium">{formatDate(data.pricing.verifiedAt)}</dd>
    </div>
  </dl>
</li>
