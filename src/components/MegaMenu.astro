---
import { departments } from '../lib/taxonomy';
import { getSiteIndex } from '../lib/site-index';

// One panel with a card per department. Each card lists a few top categories (those with the most checked
// products first) and links to the whole department. Built from the taxonomy, so it follows the data.
// Narrow screens skip the panel and link straight to the full category list.
const index = await getSiteIndex();
const SHOWN = 4;
const cards = departments.map((d) => {
  const top = d.categories
    .filter((c) => c.level === 'L1')
    .map((c, order) => ({ c, order, n: index.categories.get(c.slug)?.products.length ?? 0 }))
    .sort((a, b) => b.n - a.n || a.order - b.order)
    .slice(0, SHOWN)
    .map((x) => x.c);
  return { slug: d.slug, name: d.name, total: d.categories.length, top };
});
---

<div class="relative" data-mega>
  <a
    href="/categories"
    class="inline-flex min-h-10 items-center rounded-md px-3 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-brand-800 lg:hidden"
    >Software</a
  >
  <button
    type="button"
    class="hidden min-h-10 items-center gap-1 rounded-md px-3 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-brand-800 lg:inline-flex"
    aria-expanded="false"
    aria-controls="mega-panel"
    data-mega-button
  >
    Software
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>

  <div
    id="mega-panel"
    hidden
    class="fixed left-1/2 top-[4rem] z-50 w-[min(72rem,95vw)] -translate-x-1/2 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl"
    data-mega-panel
  >
    <div class="flex items-center justify-between gap-4 border-b border-slate-100 bg-brand-50 px-6 py-3">
      <p class="text-sm font-semibold text-brand-900">Browse {departments.length} departments</p>
      <a href="/categories" class="text-sm font-semibold text-brand-700 hover:underline">See every category</a>
    </div>
    <div class="max-h-[70vh] overflow-y-auto p-6">
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          cards.map((card) => (
            <li>
              <a href={`/categories/${card.slug}`} class="text-sm font-bold text-slate-900 hover:text-brand-700">
                {card.name}
              </a>
              <ul class="mt-2 space-y-0.5" role="list">
                {card.top.map((c) => (
                  <li>
                    <a href={`/software/${c.slug}`} class="inline-block py-0.5 text-sm text-slate-600 hover:text-brand-700 hover:underline">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/categories/${card.slug}`} class="mt-1 inline-block text-xs font-semibold text-brand-700 hover:underline">
                All {card.total} categories
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mega]');
  if (root) {
    const button = root.querySelector<HTMLButtonElement>('[data-mega-button]')!;
    const panel = root.querySelector<HTMLElement>('[data-mega-panel]')!;
    const hover = () => window.matchMedia('(hover: hover) and (min-width: 1024px)').matches;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };

    // With a mouse the menu opens on hover, so a click must not close it again.
    button.addEventListener('click', () => setOpen(hover() ? true : panel.hidden));
    let closeTimer: number | undefined;
    root.addEventListener('mouseenter', () => {
      window.clearTimeout(closeTimer);
      if (hover()) setOpen(true);
    });
    root.addEventListener('mouseleave', () => {
      if (hover()) closeTimer = window.setTimeout(() => setOpen(false), 250);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) setOpen(false);
    });
  }
</script>
