---
// Inline mark so the header needs no extra request. Same artwork as public/favicon.svg.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="7" fill="#0f766e"></rect>
  <rect x="7" y="17" width="4.5" height="8" rx="1.2" fill="#fff"></rect>
  <rect x="13.75" y="12" width="4.5" height="13" rx="1.2" fill="#fff"></rect>
  <rect x="20.5" y="7" width="4.5" height="18" rx="1.2" fill="#fff"></rect>
  <rect x="20.5" y="7" width="4.5" height="5" rx="1.2" fill="#fbbf24"></rect>
</svg>
