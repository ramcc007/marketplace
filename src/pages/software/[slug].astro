---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GateNote from '../../components/GateNote.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, categoryTitle, childrenOf, getCategory, getDepartment, relatedCategories } from '../../lib/taxonomy';
import { getSiteIndex } from '../../lib/site-index';
import { priceSummary } from '../../lib/catalog';
import { GATE } from '../../lib/quality-gate';
import { breadcrumbList, itemList } from '../../lib/schema';
import { formatDate, formatUsd } from '../../lib/dates';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const category = getCategory(Astro.params.slug!)!;
const index = await getSiteIndex();
const { products, editorial, gate } = index.categories.get(category.slug)!;
const dept = getDepartment(category.departmentSlug)!;
const parent = category.parentSlug ? getCategory(category.parentSlug) : undefined;
const children = childrenOf(category.slug);
const related = relatedCategories(category);
const site = Astro.site ?? new URL(Astro.url.origin);

const title = editorial?.data.title ?? categoryTitle(category);
const description =
  editorial?.data.definition ??
  `${title} compared: what a product needs to be listed, which products qualify, and prices with the date we checked them.`;
const Editorial = editorial ? (await render(editorial)).Content : null;
const minProducts = category.level === 'L2' ? GATE.subcategory.minQualifyingProducts : GATE.category.minQualifyingProducts;
const prices = priceSummary(products);
const paying = products.filter((p) => p.data.paidRelationship);
const lastUpdate = editorial?.data.updateLog.at(-1);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: dept.name, path: `/categories/${dept.slug}` },
  ...(parent ? [{ name: parent.name, path: `/software/${parent.slug}` }] : []),
  { name: category.name, path: `/software/${category.slug}` },
];
const jsonLd = [breadcrumbList(crumbs, site)];
if (products.length > 0) {
  jsonLd.push(itemList(products.map((p) => ({ name: p.data.name, path: `/products/${p.id}` })), site));
}
---

<BaseLayout title={title} description={description} path={`/software/${category.slug}`} index={gate.indexable} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
    <p class="mt-2 text-sm text-slate-500">Also searched as {category.aliases.join(', ')}</p>
    <div class="mt-6"><GateNote gate={gate} /></div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        {
          !gate.indexable && (
            <p class="rounded border border-slate-200 bg-slate-50 p-4 text-slate-700">
              {products.length >= minProducts
                ? `${products.length} products meet the inclusion criteria below. Rankings appear once enough verified reviews are in, so the list is in alphabetical order for now.`
                : `Products for this category are still being checked. Rankings appear once at least ${minProducts} products meet the inclusion criteria below and enough verified reviews are in.`}
            </p>
          )
        }

        {
          Editorial && (
            <div class="editorial mt-8">
              <Editorial />
            </div>
          )
        }

        <section class="mt-8" aria-labelledby="criteria">
          <h2 id="criteria" class="text-xl font-semibold">What a product needs to be listed</h2>
          <ul class="mt-3 space-y-1.5">
            {
              category.mustHave.map((item) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-teal-700">
                    &#10003;
                  </span>
                  <span class="first-letter:uppercase">{item}</span>
                </li>
              ))
            }
          </ul>
          {
            !editorial?.data.criteriaApproved && (
              <p class="mt-2 text-sm text-slate-500">Draft criteria. An editor approves them before the category opens.</p>
            )
          }
        </section>

        <section class="mt-10" aria-labelledby="products">
          <h2 id="products" class="text-xl font-semibold">Products that meet the criteria</h2>
          {
            products.length === 0 ? (
              <p class="mt-3 text-slate-600">No product has been verified against these criteria yet.</p>
            ) : (
              <ul class="mt-4 space-y-4">
                {products.map((p) => (
                  <ProductCard product={p} />
                ))}
              </ul>
            )
          }
        </section>

        {
          prices.products >= 3 && (
            <section class="mt-10" aria-labelledby="prices">
              <h2 id="prices" class="text-xl font-semibold">
                Prices across {prices.products} products
              </h2>
              <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3">
                {prices.lowestStart !== null && (
                  <div class="rounded border border-slate-200 p-3">
                    <dt class="text-sm text-slate-500">Lowest starting price</dt>
                    <dd class="text-lg font-semibold">{formatUsd(prices.lowestStart)} a month</dd>
                  </div>
                )}
                {prices.medianStart !== null && (
                  <div class="rounded border border-slate-200 p-3">
                    <dt class="text-sm text-slate-500">Median starting price</dt>
                    <dd class="text-lg font-semibold">{formatUsd(prices.medianStart)} a month</dd>
                  </div>
                )}
                <div class="rounded border border-slate-200 p-3">
                  <dt class="text-sm text-slate-500">Free plan</dt>
                  <dd class="text-lg font-semibold">
                    {prices.withFreePlan} of {prices.products}
                  </dd>
                </div>
                <div class="rounded border border-slate-200 p-3">
                  <dt class="text-sm text-slate-500">Free trial</dt>
                  <dd class="text-lg font-semibold">
                    {prices.withFreeTrial} of {prices.products}
                  </dd>
                </div>
                <div class="rounded border border-slate-200 p-3">
                  <dt class="text-sm text-slate-500">Price on request only</dt>
                  <dd class="text-lg font-semibold">
                    {prices.quoteOnly} of {prices.products}
                  </dd>
                </div>
              </dl>
              {prices.withUsdStart < prices.products && (
                <p class="mt-2 text-sm text-slate-500">
                  Lowest and median prices cover the {prices.withUsdStart} products with a published flat price in USD.
                </p>
              )}
            </section>
          )
        }

        <section class="mt-10" aria-labelledby="who-pays">
          <h2 id="who-pays" class="text-xl font-semibold">Who pays us</h2>
          {
            paying.length === 0 ? (
              <p class="mt-3 text-slate-600">
                No product in this category pays us for a subscription, a sponsored placement or an affiliate link.
              </p>
            ) : (
              <ul class="mt-3 list-disc pl-5 text-slate-700">
                {paying.map((p) => (
                  <li>
                    {p.data.name}: {p.data.paidRelationship!.type} since {formatDate(p.data.paidRelationship!.since)}
                  </li>
                ))}
              </ul>
            )
          }
          <p class="mt-2 text-sm text-slate-500">
            Payment never changes the order of the list above. <a href="/transparency" class="text-teal-700 underline">How we
            keep it that way</a>
          </p>
        </section>

        {
          lastUpdate && (
            <p class="mt-10 text-sm text-slate-500">
              Last updated {formatDate(lastUpdate.date)}: {lastUpdate.note}
            </p>
          )
        }
      </div>

      <aside class="space-y-8 text-sm">
        {
          parent && (
            <div>
              <h2 class="font-semibold">Part of</h2>
              <a href={`/software/${parent.slug}`} class="mt-2 inline-block text-teal-700 hover:underline">
                {parent.name}
              </a>
            </div>
          )
        }
        {
          children.length > 0 && (
            <div>
              <h2 class="font-semibold">More specific categories</h2>
              <ul class="mt-2 space-y-1">
                {children.map((c) => (
                  <li>
                    <a href={`/software/${c.slug}`} class="text-teal-700 hover:underline">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          related.length > 0 && (
            <div>
              <h2 class="font-semibold">Related in {dept.name}</h2>
              <ul class="mt-2 space-y-1">
                {related.map((c) => (
                  <li>
                    <a href={`/software/${c.slug}`} class="text-slate-700 hover:text-teal-700">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
