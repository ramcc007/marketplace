---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GateNote from '../../components/GateNote.astro';
import ProductCard from '../../components/ProductCard.astro';
import CompareTable from '../../components/CompareTable.astro';
import { categories, categoryTitle, childrenOf, getCategory, getDepartment, relatedCategories } from '../../lib/taxonomy';
import { getSiteIndex } from '../../lib/site-index';
import { priceSummary } from '../../lib/catalog';
import { GATE } from '../../lib/quality-gate';
import { breadcrumbList, collectionPage } from '../../lib/schema';
import { SITE } from '../../config/site';
import { formatUsd } from '../../lib/dates';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const category = getCategory(Astro.params.slug!)!;
const index = await getSiteIndex();
const { products, editorial, gate } = index.categories.get(category.slug)!;
const dept = getDepartment(category.departmentSlug)!;
const parent = category.parentSlug ? getCategory(category.parentSlug) : undefined;
const children = childrenOf(category.slug);
const related = relatedCategories(category);
const site = Astro.site ?? new URL(Astro.url.origin);

const title = editorial?.data.title ?? categoryTitle(category);
// Other names buyers search for, minus ones that only repeat the title with a generic word swapped in.
const GENERIC = new RegExp("\\b(software|tools?|platforms?|builders?|systems?|solutions?|apps?|management|manager|makers?)\\b", 'g');
const core = (text: string) => text.toLowerCase().replace(GENERIC, ' ').split(/\s+/).filter(Boolean).join(' ');
const otherNames = category.aliases.filter((alias) => core(alias) !== core(category.name));
const description =
  editorial?.data.definition ??
  `${title} compared: what a product needs to be listed, which products qualify, and where their prices come from.`;
// Search titles and descriptions follow the pattern buyers see on comparison sites. The edition year is 2027 by owner decision.
const seoName = categoryTitle(category).replace(/ software$/, ' Software');
// Longest form first. Google shows about 60 characters, so long category names fall back to a shorter ending.
const seoTitle =
  [`Best ${seoName} 2027: Pricing & Comparison`, `Best ${seoName} 2027: Pricing`, `Best ${seoName} 2027`].find((t) => t.length <= 60) ??
  `${seoName} 2027`;
const listDescription = `Compare ${products.length} ${category.name} tools by pricing, plans and features. Every price links to the vendor page it came from.`;
const seoDescription = products.length > 0 && listDescription.length <= 160 ? listDescription : description;
const Editorial = editorial ? (await render(editorial)).Content : null;
const minProducts = category.level === 'L2' ? GATE.subcategory.minQualifyingProducts : GATE.category.minQualifyingProducts;
const prices = priceSummary(products);
const paying = products.filter((p) => p.data.paidRelationship);
const lastUpdate = editorial?.data.updateLog.at(-1);

// Where to send someone who landed on a category with nothing in it yet.
const populatedRelated = [...index.categories.values()]
  .filter((c) => c.products.length > 0 && c.category.departmentSlug === category.departmentSlug && c.category.slug !== category.slug)
  .slice(0, 6);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: dept.name, path: `/categories/${dept.slug}` },
  ...(parent ? [{ name: parent.name, path: `/software/${parent.slug}` }] : []),
  { name: category.name, path: `/software/${category.slug}` },
];
const jsonLd = [breadcrumbList(crumbs, site)];
if (products.length > 0) {
  jsonLd.push(
    collectionPage({
      name: title,
      description,
      path: `/software/${category.slug}`,
      siteName: SITE.name,
      site,
      about: category.name,
      products: products.map((p) => ({ name: p.data.name, path: `/products/${p.id}` })),
    }),
  );
}

const toc = [
  ...(products.length > 0 ? [{ id: 'compare', label: 'Compare at a glance' }] : []),
  ...(Editorial ? [{ id: 'notes', label: 'Our notes' }] : []),
  { id: 'criteria', label: 'What a product needs' },
  ...(products.length > 0 ? [{ id: 'products', label: 'Products in brief' }] : []),
  ...(prices.products >= 3 ? [{ id: 'prices', label: 'Price summary' }] : []),
  { id: 'who-pays', label: 'Who pays us' },
];
---

<BaseLayout title={seoTitle} description={seoDescription} path={`/software/${category.slug}`} index={gate.indexable} jsonLd={jsonLd}>
  <section class="hero-bg border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
      {
        (editorial?.data.definition ?? category.description) && (
          <p class="mt-3 max-w-3xl text-lg leading-relaxed text-slate-600">{editorial?.data.definition ?? category.description}</p>
        )
      }
      {otherNames.length > 0 && <p class="mt-2 text-sm text-slate-500">Also called {otherNames.join(', ')}</p>}
      <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <div>
          <dt class="text-slate-500">Products checked</dt>
          <dd class="text-base font-semibold text-slate-900">{products.length}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Order of the list</dt>
          <dd class="text-base font-semibold text-slate-900">Alphabetical</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8">
    <GateNote gate={gate} />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="min-w-0">
        {
          !gate.indexable && products.length > 0 && (
            <p class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
              {products.length >= minProducts
                ? `${products.length} products meet the inclusion criteria. Reviews are not open yet, so the list is in alphabetical order and carries no scores.`
                : `${products.length} products meet the inclusion criteria so far. We open rankings for a category once at least ${minProducts} do and verified reviews are in. Until then the list is alphabetical.`}
            </p>
          )
        }

        {
          products.length > 0 && (
            <section class="mt-6" aria-labelledby="compare">
              <h2 id="compare" class="text-xl font-semibold text-slate-900">Compare at a glance</h2>
              <CompareTable products={products} />
            </section>
          )
        }

        {
          Editorial && (
            <section class="mt-12" aria-labelledby="notes">
              <h2 id="notes" class="text-xl font-semibold text-slate-900">Our notes</h2>
              <div class="editorial mt-2">
                <Editorial />
              </div>
            </section>
          )
        }

        <section class="mt-12" aria-labelledby="criteria">
          <h2 id="criteria" class="text-xl font-semibold text-slate-900">What a product needs to be listed</h2>
          <ul class="mt-3 space-y-2">
            {
              category.mustHave.map((item) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-brand-50 text-xs font-bold text-brand-700">
                    &#10003;
                  </span>
                  <span class="first-letter:uppercase">{item}</span>
                </li>
              ))
            }
          </ul>
          {
            !editorial?.data.criteriaApproved && (
              <p class="mt-3 text-sm text-slate-500">These are draft criteria. An editor approves them before the category opens.</p>
            )
          }
        </section>

        <section class="mt-12" aria-labelledby="products">
          <h2 id="products" class="text-xl font-semibold text-slate-900">
            {products.length > 0 ? 'Products in brief' : 'Products that meet the criteria'}
          </h2>
          {
            products.length === 0 ? (
              <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6">
                <p class="font-medium text-slate-900">No product has been checked against these criteria yet.</p>
                <p class="mt-1 text-sm text-slate-600">
                  We add products only after reading the vendor's own pages for each requirement above, so this list stays
                  empty until that is done.
                </p>
                {populatedRelated.length > 0 && (
                  <>
                    <p class="mt-4 text-sm font-medium text-slate-700">Categories in {dept.name} that already have products:</p>
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {populatedRelated.map((c) => (
                        <li>
                          <a
                            href={`/software/${c.category.slug}`}
                            class="inline-flex items-center rounded-full border border-slate-300 bg-white px-3 py-1 text-sm text-slate-700 hover:border-brand-700 hover:text-brand-800"
                          >
                            {c.category.name} <span class="ml-1.5 text-slate-500">{c.products.length}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            ) : (
              <ul class="mt-4 grid gap-4 md:grid-cols-2">
                {products.map((p) => (
                  <ProductCard product={p} />
                ))}
              </ul>
            )
          }
        </section>

        {
          prices.products >= 3 && (
            <section class="mt-12" aria-labelledby="prices">
              <h2 id="prices" class="text-xl font-semibold text-slate-900">Prices across {prices.products} products</h2>
              <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {prices.lowestStart !== null && (
                  <div class="rounded-xl border border-slate-200 bg-white p-4">
                    <dt class="text-sm text-slate-500">Lowest starting price</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{formatUsd(prices.lowestStart)} a month</dd>
                  </div>
                )}
                {prices.medianStart !== null && (
                  <div class="rounded-xl border border-slate-200 bg-white p-4">
                    <dt class="text-sm text-slate-500">Median starting price</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{formatUsd(prices.medianStart)} a month</dd>
                  </div>
                )}
                <div class="rounded-xl border border-slate-200 bg-white p-4">
                  <dt class="text-sm text-slate-500">Free plan</dt>
                  <dd class="mt-1 text-lg font-semibold text-slate-900">
                    {prices.withFreePlan} of {prices.products}
                  </dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-4">
                  <dt class="text-sm text-slate-500">Free trial</dt>
                  <dd class="mt-1 text-lg font-semibold text-slate-900">
                    {prices.withFreeTrial} of {prices.products}
                  </dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-4">
                  <dt class="text-sm text-slate-500">Price on request only</dt>
                  <dd class="mt-1 text-lg font-semibold text-slate-900">
                    {prices.quoteOnly} of {prices.products}
                  </dd>
                </div>
              </dl>
              {prices.withUsdStart < prices.products && (
                <p class="mt-2 text-sm text-slate-500">
                  Lowest and median prices cover the {prices.withUsdStart} products with a published flat price in USD.
                </p>
              )}
            </section>
          )
        }

        <section class="mt-12" aria-labelledby="who-pays">
          <h2 id="who-pays" class="text-xl font-semibold text-slate-900">Who pays us</h2>
          {
            paying.length === 0 ? (
              <p class="mt-3 text-slate-600">
                No product in this category pays us for a subscription, a sponsored placement or an affiliate link.
              </p>
            ) : (
              <ul class="mt-3 list-disc pl-5 text-slate-700">
                {paying.map((p) => (
                  <li>
                    {p.data.name}: {p.data.paidRelationship!.type}
                  </li>
                ))}
              </ul>
            )
          }
          <p class="mt-2 text-sm text-slate-500">
            Payment never changes the order of the list. <a href="/advertising-disclosure" class="text-brand-700 underline">How we keep it that way</a>
          </p>
        </section>

        {
          lastUpdate && (
            <p class="mt-10 border-t border-slate-200 pt-4 text-sm text-slate-500">
              Latest change: {lastUpdate.note}
            </p>
          )
        }
      </div>

      <aside class="space-y-8 text-sm lg:sticky lg:top-24 lg:self-start">
        <nav aria-label="On this page">
          <h2 class="font-semibold text-slate-900">On this page</h2>
          <ul class="mt-2 space-y-1.5 border-l border-slate-200">
            {
              toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} class="-ml-px block border-l border-transparent py-0.5 pl-3 text-slate-600 hover:border-brand-700 hover:text-brand-800">
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          parent && (
            <div>
              <h2 class="font-semibold text-slate-900">Part of</h2>
              <a href={`/software/${parent.slug}`} class="mt-2 inline-block text-brand-700 hover:underline">
                {parent.name}
              </a>
            </div>
          )
        }
        {
          children.length > 0 && (
            <div>
              <h2 class="font-semibold text-slate-900">More specific categories</h2>
              <ul class="mt-2 space-y-1">
                {children.map((c) => (
                  <li>
                    <a href={`/software/${c.slug}`} class="text-brand-700 hover:underline">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          related.length > 0 && (
            <div>
              <h2 class="font-semibold text-slate-900">Related in {dept.name}</h2>
              <ul class="mt-2 space-y-1">
                {related.map((c) => (
                  <li>
                    <a href={`/software/${c.slug}`} class="text-slate-700 hover:text-brand-800">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
