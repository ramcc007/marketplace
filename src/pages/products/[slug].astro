---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GateNote from '../../components/GateNote.astro';
import {
  getProducts,
  inclusionEvidence,
  meetsInclusion,
  pricingAgeDays,
  fromPhrase,
  startingMonthlyUsd,
  startingPriceLabel,
  type Product,
} from '../../lib/catalog';
import { categories, getCategory, getDepartment } from '../../lib/taxonomy';
import { getSiteIndex } from '../../lib/site-index';
import { getReviewStats } from '../../lib/reviews';
import { GATE } from '../../lib/quality-gate';
import { breadcrumbList, softwareApplication } from '../../lib/schema';
import { formatMoney, formatUsd, formatVolumeFee } from '../../lib/dates';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { data } = product;
const index = await getSiteIndex();
const gate = index.productGates.get(product.id)!;
const site = Astro.site ?? new URL(Astro.url.origin);
const primary = getCategory(data.primaryCategory);
const dept = primary ? getDepartment(primary.departmentSlug) : undefined;
const listedIn = categories.filter((c) => meetsInclusion(product, c));
const start = startingMonthlyUsd(product);
const stale = pricingAgeDays(product, index.today) > GATE.stalePricingDays;
const reviews = getReviewStats(product.id);
const yesNo = (v: boolean | null) => (v === null ? 'Not stated' : v ? 'Yes' : 'No');
const billingLabel = { month: 'a month', year: 'a year', one_time: 'one time', quote: '' } as const;

type PlanRow = Product['data']['pricing']['plans'][number];
// A plan with a flat price and a share-of-revenue fee shows both; "Free" alone would hide the fee.
function planPrice(plan: PlanRow): string {
  const fee = plan.volumeFee ? formatVolumeFee(plan.volumeFee) : '';
  const period = billingLabel[plan.billing];
  if (plan.priceUsd !== null) {
    if (plan.priceUsd === 0) return fee ? `No fixed fee, plus ${fee}` : 'Free';
    const flat = `${formatUsd(plan.priceUsd)} ${period}`.trim();
    return fee ? `${flat}, plus ${fee}` : flat;
  }
  if (plan.listedPrice) return `${formatMoney(plan.listedPrice.amount, plan.listedPrice.currency)} ${period}`.trim();
  return fee || 'On request';
}

// Other products in the same primary category, so a reader can keep comparing without going back.
const peers = (primary ? (index.categories.get(primary.slug)?.products ?? []) : [])
  .filter((p) => p.id !== product.id)
  .slice(0, 6);

const crumbs = [
  { name: 'Home', path: '/' },
  ...(dept ? [{ name: dept.name, path: `/categories/${dept.slug}` }] : []),
  ...(primary ? [{ name: primary.name, path: `/software/${primary.slug}` }] : []),
  { name: data.name, path: `/products/${product.id}` },
];
const description = data.summary.length <= 155 ? data.summary : `${data.summary.slice(0, 152)}...`;

const jump = [
  { id: 'pricing', label: 'Pricing' },
  ...(listedIn.length > 0 ? [{ id: 'listed-in', label: 'Categories' }] : []),
  ...(data.facts.length > 0 ? [{ id: 'facts', label: 'Facts checked' }] : []),
  ...(data.security ? [{ id: 'security', label: 'Security' }] : []),
  ...(data.contract ? [{ id: 'contract', label: 'Contract' }] : []),
  { id: 'reviews', label: 'Reviews' },
];
---

<BaseLayout
  title={`${data.name} pricing and features`.length <= 60 ? `${data.name} pricing and features` : `${data.name} pricing`}
  description={description}
  path={`/products/${product.id}`}
  index={gate.indexable}
  jsonLd={[
    breadcrumbList(crumbs, site),
    softwareApplication({
      name: data.name,
      path: `/products/${product.id}`,
      site,
      description: data.summary,
      vendor: data.vendor.name,
      lowestMonthlyUsd: start,
    }),
  ]}
>
  <section class="hero-bg border-b border-slate-200">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:py-10">
      <Breadcrumbs crumbs={crumbs} />
      {
        data.status === 'draft' && (
          <p class="mt-4 rounded bg-amber-100 px-3 py-2 text-sm text-amber-900">Draft. Not included in production builds.</p>
        )
      }
      <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{data.name}</h1>
          <p class="mt-1 text-slate-500">By {data.vendor.name}</p>
        </div>
        <a
          href={data.vendor.website}
          rel="nofollow noopener"
          class="no-print inline-flex min-h-11 items-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-800 hover:border-brand-700 hover:text-brand-800"
        >
          Vendor's website <span aria-hidden="true" class="ml-1.5">&#8599;</span>
        </a>
      </div>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-700">{data.summary}</p>

      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-slate-200 bg-slate-200 text-sm sm:grid-cols-4">
        <div class="bg-white p-4">
          <dt class="text-slate-500">From</dt>
          <dd class="mt-0.5 font-semibold text-slate-900">{startingPriceLabel(product)}</dd>
        </div>
        <div class="bg-white p-4">
          <dt class="text-slate-500">Free plan</dt>
          <dd class="mt-0.5 font-semibold text-slate-900">{data.pricing.freePlan ? 'Yes' : 'No'}</dd>
        </div>
        <div class="bg-white p-4">
          <dt class="text-slate-500">Free trial</dt>
          <dd class="mt-0.5 font-semibold text-slate-900">
            {data.pricing.freeTrialDays ? `${data.pricing.freeTrialDays} days` : 'No'}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-8">
    <GateNote gate={gate} />

    <nav aria-label="On this page" class="no-print -mt-1 mb-6">
      <ul class="flex flex-wrap gap-2 text-sm">
        {
          jump.map((j) => (
            <li>
              <a href={`#${j.id}`} class="inline-flex min-h-9 items-center rounded-full border border-slate-200 px-3.5 text-slate-600 hover:border-brand-700 hover:text-brand-800">
                {j.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      data.handsOnNote && (
        <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Our hands-on notes</h2>
          <p class="mt-2 text-slate-700">{data.handsOnNote}</p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="pricing">
      <h2 id="pricing" class="text-xl font-semibold text-slate-900">Pricing</h2>
      <p class="mt-1 text-sm text-slate-500">
        Taken from the <a href={data.pricing.sourceUrl} rel="nofollow noopener" class="text-brand-700 underline">vendor's pricing page</a>.
        {data.pricing.freeTrialDays ? ` Free trial: ${data.pricing.freeTrialDays} days.` : ''}
      </p>
      {
        stale && (
          <p class="mt-2 rounded bg-amber-50 px-3 py-2 text-sm text-amber-900">
            These prices have not been re-checked for more than {GATE.stalePricingDays} days.
          </p>
        )
      }
      {
        data.pricing.plans.length > 0 && (
          <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white">
            <table class="data-table min-w-[36rem]">
              <caption class="sr-only">Plans and prices for {data.name}</caption>
              <thead>
                <tr>
                  <th scope="col">Plan</th>
                  <th scope="col">Price</th>
                  <th scope="col">Charged</th>
                  <th scope="col">Notes</th>
                </tr>
              </thead>
              <tbody>
                {data.pricing.plans.map((plan) => (
                  <tr>
                    <th scope="row">
                      {plan.name}
                    </th>
                    <td>{planPrice(plan)}</td>
                    <td>{plan.unit}</td>
                    <td class="text-slate-600">
                      {plan.notes ?? ''}
                      {plan.sourceUrl && (
                        <a href={plan.sourceUrl} rel="nofollow noopener" class="ml-1 text-slate-500 underline hover:text-brand-700">source</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      {
        data.pricing.hiddenCosts.length > 0 && (
          <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4">
            <h3 class="font-semibold text-amber-950">Costs not in the plan price</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-800">
              {data.pricing.hiddenCosts.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {
      listedIn.length > 0 && (
        <section class="mt-12" aria-labelledby="listed-in">
          <h2 id="listed-in" class="text-xl font-semibold text-slate-900">Categories it qualifies for</h2>
          <ul class="mt-3 space-y-5">
            {listedIn.map((c) => (
              <li>
                <a href={`/software/${c.slug}`} class="font-medium text-brand-700 hover:underline">
                  {c.name}
                </a>
                <ul class="mt-1.5 space-y-1 text-sm text-slate-600">
                  {inclusionEvidence(product, c).map((e) => (
                    <li class="flex flex-wrap gap-x-2">
                      <span aria-hidden="true" class="text-brand-700">&#10003;</span>
                      <span class="first-letter:uppercase">{e.capability}</span>
                      <a href={e.sourceUrl} rel="nofollow noopener" class="text-slate-500 underline hover:text-brand-700">source</a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.facts.length > 0 && (
        <section class="mt-12" aria-labelledby="facts">
          <h2 id="facts" class="text-xl font-semibold text-slate-900">Facts we checked</h2>
          <ul class="mt-3 space-y-3 text-slate-700">
            {data.facts.map((f) => (
              <li class="leading-relaxed">
                {f.text}{' '}
                <a href={f.sourceUrl} rel="nofollow noopener" class="text-sm text-slate-500 underline hover:text-brand-700">
                  Source
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.security && (
        <section class="mt-12" aria-labelledby="security">
          <h2 id="security" class="text-xl font-semibold text-slate-900">Security and compliance</h2>
          <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">SOC 2</dt><dd class="font-medium text-slate-900">{yesNo(data.security.soc2)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">ISO 27001</dt><dd class="font-medium text-slate-900">{yesNo(data.security.iso27001)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">GDPR</dt><dd class="font-medium text-slate-900">{yesNo(data.security.gdpr)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">HIPAA</dt><dd class="font-medium text-slate-900">{yesNo(data.security.hipaa)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">Single sign-on</dt><dd class="font-medium text-slate-900">{data.security.ssoPlan ? `${data.security.ssoPlan} plan and up` : 'Not stated'}</dd></div>
          </dl>
          <p class="mt-2 text-sm text-slate-500">
            Taken from the <a href={data.security.sourceUrl} rel="nofollow noopener" class="text-brand-700 underline">vendor's security page</a>.
          </p>
        </section>
      )
    }

    {
      data.contract && (
        <section class="mt-12" aria-labelledby="contract">
          <h2 id="contract" class="text-xl font-semibold text-slate-900">Contract terms</h2>
          <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">Annual contract required</dt><dd class="font-medium text-slate-900">{yesNo(data.contract.annualOnly)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">Minimum seats</dt><dd class="font-medium text-slate-900">{data.contract.minSeats ?? 'None stated'}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">Renews automatically</dt><dd class="font-medium text-slate-900">{yesNo(data.contract.autoRenew)}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3"><dt class="text-slate-500">Cancellation</dt><dd class="font-medium text-slate-900">{data.contract.cancellation ?? 'Not stated'}</dd></div>
            <div class="rounded-lg border border-slate-200 p-3 sm:col-span-2">
              <dt class="text-slate-500">Data export</dt>
              <dd class="font-medium text-slate-900">
                {data.contract.dataExport ?? 'Not stated'}
                {data.contract.exportSourceUrl && (
                  <a href={data.contract.exportSourceUrl} rel="nofollow noopener" class="ml-1 text-sm font-normal text-slate-500 underline hover:text-brand-700">source</a>
                )}
              </dd>
            </div>
          </dl>
          <p class="mt-2 text-sm text-slate-500">
            Taken from the <a href={data.contract.sourceUrl} rel="nofollow noopener" class="text-brand-700 underline">vendor's terms</a>.
          </p>
        </section>
      )
    }

    <section class="mt-12" aria-labelledby="reviews">
      <h2 id="reviews" class="text-xl font-semibold text-slate-900">Reviews</h2>
      <p class="mt-3 text-slate-600">
        {
          reviews.count === 0
            ? 'Review collection has not opened yet, so there are no reviews to show. When it opens, reviewers will confirm their identity with a work email or LinkedIn before a review is published.'
            : `${reviews.count} verified reviews.`
        }
      </p>
    </section>

    <section class="mt-12" aria-labelledby="who-pays">
      <h2 id="who-pays" class="text-xl font-semibold text-slate-900">Who pays us</h2>
      <p class="mt-3 text-slate-600">
        {
          data.paidRelationship
            ? `${data.vendor.name} pays us (${data.paidRelationship.type}). This does not change its ranking.`
            : `${data.vendor.name} does not pay us anything.`
        }
      </p>
    </section>

    {
      peers.length > 0 && primary && (
        <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="peers">
          <h2 id="peers" class="text-xl font-semibold text-slate-900">Compare with other {primary.name.toLowerCase()} products</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {peers.map((p) => (
              <li>
                <a href={`/products/${p.id}`} class="block rounded-xl border border-slate-200 p-4 hover:border-brand-700">
                  <span class="font-semibold text-slate-900">{p.data.name}</span>
                  <span class="mt-0.5 block text-sm text-slate-600">{fromPhrase(p)}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-sm">
            <a href={`/software/${primary.slug}`} class="text-brand-700 underline">See all {primary.name.toLowerCase()} products side by side</a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>
