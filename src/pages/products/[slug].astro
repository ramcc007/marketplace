---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GateNote from '../../components/GateNote.astro';
import {
  getProducts,
  inclusionEvidence,
  meetsInclusion,
  pricingAgeDays,
  startingMonthlyUsd,
  type Product,
} from '../../lib/catalog';
import { categories, getCategory, getDepartment } from '../../lib/taxonomy';
import { getSiteIndex } from '../../lib/site-index';
import { getReviewStats } from '../../lib/reviews';
import { GATE } from '../../lib/quality-gate';
import { breadcrumbList, softwareApplication } from '../../lib/schema';
import { formatDate, formatMoney, formatUsd, formatVolumeFee } from '../../lib/dates';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const { data } = product;
const index = await getSiteIndex();
const gate = index.productGates.get(product.id)!;
const site = Astro.site ?? new URL(Astro.url.origin);
const primary = getCategory(data.primaryCategory);
const dept = primary ? getDepartment(primary.departmentSlug) : undefined;
const listedIn = categories.filter((c) => meetsInclusion(product, c));
const start = startingMonthlyUsd(product);
const stale = pricingAgeDays(product, index.today) > GATE.stalePricingDays;
const reviews = getReviewStats(product.id);
const yesNo = (v: boolean | null) => (v === null ? 'Not stated' : v ? 'Yes' : 'No');
const billingLabel = { month: 'a month', year: 'a year', one_time: 'one time', quote: '' } as const;

const crumbs = [
  { name: 'Home', path: '/' },
  ...(dept ? [{ name: dept.name, path: `/categories/${dept.slug}` }] : []),
  ...(primary ? [{ name: primary.name, path: `/software/${primary.slug}` }] : []),
  { name: data.name, path: `/products/${product.id}` },
];
const description = data.summary.length <= 155 ? data.summary : `${data.summary.slice(0, 152)}...`;
---

<BaseLayout
  title={`${data.name} pricing and features`}
  description={description}
  path={`/products/${product.id}`}
  index={gate.indexable}
  jsonLd={[
    breadcrumbList(crumbs, site),
    softwareApplication({
      name: data.name,
      path: `/products/${product.id}`,
      site,
      description: data.summary,
      vendor: data.vendor.name,
      lowestMonthlyUsd: start,
    }),
  ]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs crumbs={crumbs} />
    {
      data.status === 'draft' && (
        <p class="mt-4 rounded bg-amber-100 px-3 py-2 text-sm text-amber-900">Draft. Not included in production builds.</p>
      )
    }
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{data.name}</h1>
    <p class="mt-1 text-slate-500">
      By <a href={data.vendor.website} rel="nofollow noopener" class="text-teal-700 hover:underline">{data.vendor.name}</a>
    </p>
    <div class="mt-6"><GateNote gate={gate} /></div>
    <p class="text-lg text-slate-700">{data.summary}</p>

    {
      data.handsOnNote && (
        <section class="mt-6 rounded border border-slate-200 p-4">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Our hands-on notes</h2>
          <p class="mt-2 text-slate-700">{data.handsOnNote}</p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="pricing">
      <h2 id="pricing" class="text-xl font-semibold">Pricing</h2>
      <p class="mt-1 text-sm text-slate-500">
        Checked {formatDate(data.pricing.verifiedAt)} on the <a href={data.pricing.sourceUrl} rel="nofollow noopener" class="text-teal-700 underline">vendor's pricing page</a>.
        {data.pricing.freeTrialDays ? ` Free trial: ${data.pricing.freeTrialDays} days.` : ''}
      </p>
      {
        stale && (
          <p class="mt-2 rounded bg-amber-50 px-3 py-2 text-sm text-amber-900">
            These prices have not been re-checked for more than {GATE.stalePricingDays} days.
          </p>
        )
      }
      {
        data.pricing.plans.length > 0 && (
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                  <th class="py-2 pr-4 font-medium">Plan</th>
                  <th class="py-2 pr-4 font-medium">Price</th>
                  <th class="py-2 pr-4 font-medium">Charged</th>
                  <th class="py-2 font-medium">Notes</th>
                </tr>
              </thead>
              <tbody>
                {data.pricing.plans.map((plan) => (
                  <tr class="border-b border-slate-100">
                    <td class="py-2 pr-4 font-medium">{plan.name}</td>
                    <td class="py-2 pr-4">
                      {plan.priceUsd !== null
                        ? plan.priceUsd === 0
                          ? 'Free'
                          : `${formatUsd(plan.priceUsd)} ${billingLabel[plan.billing]}`
                        : plan.listedPrice
                          ? `${formatMoney(plan.listedPrice.amount, plan.listedPrice.currency)} ${billingLabel[plan.billing]}`
                          : plan.volumeFee
                            ? formatVolumeFee(plan.volumeFee)
                            : 'On request'}
                    </td>
                    <td class="py-2 pr-4">{plan.unit}</td>
                    <td class="py-2 text-slate-600">
                      {plan.notes ?? ''}
                      {plan.sourceUrl && (
                        <a href={plan.sourceUrl} rel="nofollow noopener" class="ml-1 text-slate-400 underline hover:text-teal-700">source</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
      {
        data.pricing.hiddenCosts.length > 0 && (
          <div class="mt-4">
            <h3 class="font-semibold">Costs not in the plan price</h3>
            <ul class="mt-2 list-disc pl-5 text-slate-700">
              {data.pricing.hiddenCosts.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <section class="mt-10" aria-labelledby="listed-in">
      <h2 id="listed-in" class="text-xl font-semibold">Categories it qualifies for</h2>
      <ul class="mt-3 space-y-4">
        {
          listedIn.map((c) => (
            <li>
              <a href={`/software/${c.slug}`} class="font-medium text-teal-700 hover:underline">
                {c.name}
              </a>
              <ul class="mt-1 space-y-0.5 text-sm text-slate-600">
                {inclusionEvidence(product, c).map((e) => (
                  <li class="flex flex-wrap gap-x-2">
                    <span aria-hidden="true" class="text-teal-700">&#10003;</span>
                    <span class="first-letter:uppercase">{e.capability}</span>
                    <a href={e.sourceUrl} rel="nofollow noopener" class="text-slate-400 underline hover:text-teal-700">source</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    {
      data.facts.length > 0 && (
        <section class="mt-10" aria-labelledby="facts">
          <h2 id="facts" class="text-xl font-semibold">Facts we checked</h2>
          <ul class="mt-3 space-y-2 text-slate-700">
            {data.facts.map((f) => (
              <li>
                {f.text}{' '}
                <a href={f.sourceUrl} rel="nofollow noopener" class="text-sm text-slate-400 underline hover:text-teal-700">
                  Source, checked {formatDate(f.checkedAt)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      data.security && (
        <section class="mt-10" aria-labelledby="security">
          <h2 id="security" class="text-xl font-semibold">Security and compliance</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
            <div><dt class="text-slate-500">SOC 2</dt><dd class="font-medium">{yesNo(data.security.soc2)}</dd></div>
            <div><dt class="text-slate-500">ISO 27001</dt><dd class="font-medium">{yesNo(data.security.iso27001)}</dd></div>
            <div><dt class="text-slate-500">GDPR</dt><dd class="font-medium">{yesNo(data.security.gdpr)}</dd></div>
            <div><dt class="text-slate-500">HIPAA</dt><dd class="font-medium">{yesNo(data.security.hipaa)}</dd></div>
            <div><dt class="text-slate-500">Single sign-on</dt><dd class="font-medium">{data.security.ssoPlan ? `${data.security.ssoPlan} plan and up` : 'Not stated'}</dd></div>
          </dl>
          <p class="mt-2 text-sm text-slate-500">
            Checked {formatDate(data.security.checkedAt)} on the <a href={data.security.sourceUrl} rel="nofollow noopener" class="text-teal-700 underline">vendor's security page</a>.
          </p>
        </section>
      )
    }

    {
      data.contract && (
        <section class="mt-10" aria-labelledby="contract">
          <h2 id="contract" class="text-xl font-semibold">Contract terms</h2>
          <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
            <div><dt class="text-slate-500">Annual contract required</dt><dd class="font-medium">{yesNo(data.contract.annualOnly)}</dd></div>
            <div><dt class="text-slate-500">Minimum seats</dt><dd class="font-medium">{data.contract.minSeats ?? 'None stated'}</dd></div>
            <div><dt class="text-slate-500">Renews automatically</dt><dd class="font-medium">{yesNo(data.contract.autoRenew)}</dd></div>
            <div><dt class="text-slate-500">Cancellation</dt><dd class="font-medium">{data.contract.cancellation ?? 'Not stated'}</dd></div>
            <div>
              <dt class="text-slate-500">Data export</dt>
              <dd class="font-medium">
                {data.contract.dataExport ?? 'Not stated'}
                {data.contract.exportSourceUrl && (
                  <a href={data.contract.exportSourceUrl} rel="nofollow noopener" class="ml-1 text-sm font-normal text-slate-400 underline hover:text-teal-700">source</a>
                )}
              </dd>
            </div>
          </dl>
          <p class="mt-2 text-sm text-slate-500">
            Checked {formatDate(data.contract.checkedAt)} in the <a href={data.contract.sourceUrl} rel="nofollow noopener" class="text-teal-700 underline">vendor's terms</a>.
          </p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="reviews">
      <h2 id="reviews" class="text-xl font-semibold">Reviews</h2>
      <p class="mt-3 text-slate-600">
        {
          reviews.count === 0
            ? 'No verified reviews yet. Reviewers confirm their identity with a work email or LinkedIn before a review is published.'
            : `${reviews.count} verified reviews.`
        }
      </p>
    </section>

    <section class="mt-10" aria-labelledby="who-pays">
      <h2 id="who-pays" class="text-xl font-semibold">Who pays us</h2>
      <p class="mt-3 text-slate-600">
        {
          data.paidRelationship
            ? `${data.vendor.name} pays us (${data.paidRelationship.type}) since ${formatDate(data.paidRelationship.since)}. This does not change its ranking.`
            : `${data.vendor.name} does not pay us anything.`
        }
      </p>
    </section>
  </div>
</BaseLayout>
