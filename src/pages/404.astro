---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist." path="/404" index={false}>
  <div class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">Error 404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900">That page is not here</h1>
    <p class="mt-4 max-w-xl text-lg text-slate-600">
      The address may be mistyped, or the page may have moved. Try the category list, or go back to the start.
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/categories" class="rounded-lg bg-brand-700 px-5 py-3 font-semibold text-white hover:bg-brand-800">Browse all categories</a>
      <a href="/" class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:border-brand-700">Home page</a>
    </p>
  </div>
</BaseLayout>
