---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist." path="/404" index={false}>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-3 text-slate-600">The address may be mistyped, or the page may have moved.</p>
    <p class="mt-6">
      <a href="/categories" class="font-medium text-teal-700 hover:underline">Browse all categories</a>
    </p>
  </div>
</BaseLayout>
