---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  { title: 'Sign in', text: 'Only signed-in users can write a review. Registering needs a confirmed work email address.' },
  { title: 'Pick the product', text: 'Search for the software you have used at work.' },
  { title: 'Tell us how you used it', text: 'What you used it for, for how long, what worked and what did not.' },
  { title: 'We check it', text: 'Each review shows how the reviewer was verified. Reviews that break the guidelines are not published.' },
];
---

<BaseLayout
  title="Leave a Review"
  description="How reviews will work on B2BRated: sign in, pick the software you use, and share your own experience. Reviews are not open yet."
  path="/leave-a-review"
  index={false}
>
  <div class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Leave a review</h1>
    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
      Reviews are not open yet, so there are none on the site. This is how it will work when they open.
    </p>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-card">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-sm font-bold text-brand-800">{i + 1}</span>
            <h2 class="mt-3 font-semibold text-slate-900">{s.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="mt-8 text-slate-700">
      Vendors cannot pay for a review or a rating. Read the <a href="/review-guidelines" class="font-semibold text-brand-700 underline">review guidelines</a>
      for what we accept, and <a href="/register" class="font-semibold text-brand-700 underline">register</a> to be ready when reviews open.
    </p>
  </div>
</BaseLayout>
