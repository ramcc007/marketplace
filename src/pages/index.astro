---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { categories, departments } from '../lib/taxonomy';
import { getSiteIndex } from '../lib/site-index';

const site = Astro.site ?? new URL(Astro.url.origin);
const index = await getSiteIndex();

const withProducts = [...index.categories.values()]
  .filter((c) => c.products.length > 0)
  .sort((a, b) => b.products.length - a.products.length || a.category.name.localeCompare(b.category.name));
const popular = withProducts.slice(0, 12);
const productCount = index.products.filter((p) => p.data.status === 'published').length;

const stats = [
  { value: String(productCount), label: 'products with prices checked' },
  { value: String(categories.length), label: 'software categories' },
  { value: String(departments.length), label: 'departments' },
  { value: '0', label: 'reviews so far, none open yet' },
];

const values = [
  {
    title: 'Prices you can check',
    text: 'Every price links to the vendor page it came from, with costs outside the plan price listed beside it.',
    href: '/methodology#prices',
    cta: 'How prices are checked',
  },
  {
    title: 'Written rules for listing',
    text: 'Each category has a short capability list. A product appears only when its own documentation meets it.',
    href: '/methodology#inclusion',
    cta: 'How products are listed',
  },
  {
    title: 'No paid rankings',
    text: 'No vendor pays us today. If that changes, paid relationships will be named, and money will not move a product up a list.',
    href: '/advertising-disclosure',
    cta: 'Read the rules',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL('/', site).toString(),
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL('/', site).toString(),
    logo: new URL('/icon-512.png', site).toString(),
  },
];
---

<BaseLayout
  title={`${SITE.name}: Compare Business Software, Pricing & Features 2027`}
  description={`Compare business software across ${categories.length} categories. See plans, pricing and features side by side, with every price linked to the vendor's own page.`}
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero-bg border-b border-slate-200">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Find the right software for your business</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">
          Compare plans, pricing and features across {categories.length} software categories. Every price links to the
          vendor page it came from.
        </p>

        <form action="/categories" method="get" role="search" class="mt-8 max-w-xl">
          <label for="home-search" class="sr-only">Search categories</label>
          <div class="flex gap-2">
            <input
              id="home-search"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Search a category, for example payroll or help desk"
              class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 text-base shadow-sm placeholder:text-slate-400 focus:border-brand-700 focus:outline-none"
            />
            <button type="submit" class="min-h-12 rounded-lg bg-brand-700 px-6 font-semibold text-white hover:bg-brand-800">Search</button>
          </div>
        </form>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
        <p class="text-sm font-semibold text-slate-900">Browse by department</p>
        <ul class="mt-4 grid grid-cols-2 gap-2">
          {
            departments.slice(0, 8).map((dept) => (
              <li>
                <a href={`/categories/${dept.slug}`} class="block rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-medium text-slate-800 hover:border-brand-700 hover:text-brand-800">
                  {dept.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/categories" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">See all {departments.length} departments</a>
      </div>
    </div>
  </section>

  <section class="bg-brand-700 text-white" aria-label="The site in numbers">
    <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-y-6 px-4 py-8 text-center sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="px-2">
            <dd class="text-3xl font-bold tracking-tight sm:text-4xl">{s.value}</dd>
            <dt class="mt-1 text-sm text-brand-50">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="values">
    <h2 id="values" class="text-center text-2xl font-bold tracking-tight text-slate-900">Why B2BRated</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {
        values.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 text-center shadow-card">
            <h3 class="text-lg font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-600">{v.text}</p>
            <a href={v.href} class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">{v.cta}</a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50" aria-labelledby="departments">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="departments" class="text-2xl font-bold tracking-tight text-slate-900">Software for every team</h2>
          <p class="mt-1 max-w-2xl text-slate-600">Start from the team that will use the tool, then narrow to a category.</p>
        </div>
        <a href="/categories" class="text-sm font-semibold text-brand-700 hover:underline">All {categories.length} categories</a>
      </div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          departments.map((dept) => (
            <li>
              <a
                href={`/categories/${dept.slug}`}
                class="flex items-baseline justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 hover:border-brand-700"
              >
                <span class="font-medium text-slate-900">{dept.name}</span>
                <span class="text-sm text-slate-500">{dept.categories.length} categories</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="popular">
    <h2 id="popular" class="text-2xl font-bold tracking-tight text-slate-900">Popular categories</h2>
    <p class="mt-1 max-w-2xl text-slate-600">The categories where we have checked the most products.</p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        popular.map((c) => (
          <li>
            <a
              href={`/software/${c.category.slug}`}
              class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-800 shadow-card hover:border-brand-700 hover:text-brand-800"
            >
              {c.category.name}
              <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-800">{c.products.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-slate-200 bg-slate-900 text-slate-200" aria-labelledby="vendor-cta">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12">
      <div class="max-w-2xl">
        <h2 id="vendor-cta" class="text-2xl font-bold tracking-tight text-white">Are you a software vendor?</h2>
        <p class="mt-2 leading-relaxed">See how products get listed, how to correct a page, and why payment never changes a ranking.</p>
      </div>
      <a href="/vendors" class="inline-flex min-h-12 items-center rounded-lg bg-white px-6 font-semibold text-slate-900 hover:bg-brand-50">For vendors</a>
    </div>
  </section>
</BaseLayout>
