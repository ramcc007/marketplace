---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { categories, departments } from '../lib/taxonomy';

const site = Astro.site ?? new URL(Astro.url.origin);
const waveOne = departments
  .map((dept) => ({ dept, items: dept.categories.filter((c) => c.wave === 1) }))
  .filter((group) => group.items.length > 0);

const principles = [
  {
    title: 'Prices with sources and dates',
    text: 'Each price links to the vendor page it came from and shows the day we checked it. Hidden costs, such as single sign-on locked to the top plan, are listed next to the price.',
    href: '/methodology#prices',
  },
  {
    title: 'Written inclusion criteria',
    text: 'Every category lists the capabilities a product needs before it can appear. Vendors cannot pay to be listed or to skip a requirement.',
    href: '/methodology#inclusion',
  },
  {
    title: 'Rankings that money cannot move',
    text: 'Scores come from a published formula based on verified reviews. Any paid placement is labeled and shown apart from the ranked list.',
    href: '/transparency',
  },
];
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL('/', site).toString() }]}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h1 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
        Business software, compared with dated prices and a public ranking method
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">
        Every price on this site links to its source and shows the day we checked it. A product is listed only when it
        meets the written inclusion criteria for its category, and no vendor can pay to change a ranking.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/categories" class="rounded bg-teal-700 px-4 py-2 font-medium text-white hover:bg-teal-800">
          Browse {categories.length} categories
        </a>
        <a href="/methodology" class="rounded border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:border-teal-700">
          How we rank
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="opening-first">
    <h2 id="opening-first" class="text-2xl font-semibold">Opening first</h2>
    <p class="mt-2 max-w-3xl text-slate-600">
      Categories open one at a time. The first 50 cover finance, HR, IT, security and DevOps tools for small and
      mid-size businesses. A category shows rankings once enough products and verified reviews are in.
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        waveOne.map(({ dept, items }) => (
          <div>
            <h3 class="font-semibold">
              <a href={`/categories/${dept.slug}`} class="hover:text-teal-700">
                {dept.name}
              </a>
            </h3>
            <ul class="mt-2 space-y-1 text-sm">
              {items.map((c) => (
                <li>
                  <a href={`/software/${c.slug}`} class="text-slate-700 hover:text-teal-700">
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50" aria-labelledby="departments">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 id="departments" class="text-2xl font-semibold">Browse by department</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          departments.map((dept) => (
            <li>
              <a
                href={`/categories/${dept.slug}`}
                class="flex items-baseline justify-between rounded border border-slate-200 bg-white px-4 py-3 hover:border-teal-700"
              >
                <span class="font-medium">{dept.name}</span>
                <span class="text-sm text-slate-500">{dept.categories.length} categories</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="different">
    <h2 id="different" class="text-2xl font-semibold">What we do differently</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {
        principles.map((p) => (
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{p.text}</p>
            <a href={p.href} class="mt-3 inline-block text-sm font-medium text-teal-700 hover:underline">
              Read how
            </a>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
