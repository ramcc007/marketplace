---
import BaseLayout from '../layouts/BaseLayout.astro';

const field = 'mt-1.5 min-h-12 w-full rounded-lg border border-slate-300 bg-slate-50 px-4 text-base text-slate-500';
---

<BaseLayout
  title="Register"
  description="Create a B2BRated account to write verified reviews. Accounts are not open yet."
  path="/register"
  index={false}
>
  <div class="mx-auto max-w-md px-4 py-14">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Create your account</h1>
    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
      Accounts are not open yet. This page shows what registering will look like. Nothing you type here is sent
      anywhere, and you do not need an account to read the site.
    </p>

    <form class="mt-6" aria-disabled="true" onsubmit="return false">
      <fieldset disabled class="space-y-4">
        <div>
          <label for="r-name" class="block text-sm font-medium text-slate-700">Full name</label>
          <input id="r-name" type="text" class={field} />
        </div>
        <div>
          <label for="r-email" class="block text-sm font-medium text-slate-700">Work email</label>
          <input id="r-email" type="email" class={field} />
          <p class="mt-1 text-xs text-slate-500">We will ask you to confirm this address before you can write a review.</p>
        </div>
        <div>
          <label for="r-pass" class="block text-sm font-medium text-slate-700">Password</label>
          <input id="r-pass" type="password" class={field} />
        </div>
        <button type="button" class="min-h-12 w-full rounded-lg bg-slate-300 px-5 font-semibold text-white">Register (coming soon)</button>
      </fieldset>
    </form>

    <p class="mt-6 text-sm text-slate-600">
      Already have an account? <a href="/login" class="font-semibold text-brand-700 underline">Log in</a>. By registering
      you will agree to the <a href="/terms" class="text-brand-700 underline">terms</a> and the
      <a href="/privacy" class="text-brand-700 underline">privacy policy</a>.
    </p>
  </div>
</BaseLayout>
