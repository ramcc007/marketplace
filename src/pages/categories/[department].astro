---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GateNote from '../../components/GateNote.astro';
import { childrenOf, departments, getDepartment } from '../../lib/taxonomy';
import { getSiteIndex } from '../../lib/site-index';
import { breadcrumbList } from '../../lib/schema';

export function getStaticPaths() {
  return departments.map((d) => ({ params: { department: d.slug } }));
}

const dept = getDepartment(Astro.params.department!)!;
const index = await getSiteIndex();
const gate = index.departmentGates.get(dept.slug)!;
const site = Astro.site ?? new URL(Astro.url.origin);
const topLevel = dept.categories.filter((c) => c.level === 'L1');
const productCount = (slug: string) => index.categories.get(slug)?.products.length ?? 0;
const checkedCount = dept.categories.filter((c) => productCount(c.slug) > 0).length;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Categories', path: '/categories' },
  { name: dept.name, path: `/categories/${dept.slug}` },
];
// Subcategories whose parent sits in another department (for example Real estate CRM) are listed on their own.
const crossDepartment = dept.categories.filter((c) => c.level === 'L2' && !topLevel.some((t) => t.slug === c.parentSlug));
---

<BaseLayout
  title={`${dept.name} Software 2027: Pricing & Comparison`}
  description={`Compare ${dept.name} software across ${dept.categories.length} categories. See pricing and features for each product, with every price linked to the vendor page.`}
  path={`/categories/${dept.slug}`}
  index={gate.indexable}
  jsonLd={[breadcrumbList(crumbs, site)]}
>
  <section class="hero-bg border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{dept.name} software</h1>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-slate-600">
        {dept.categories.length} categories. We have checked products in {checkedCount} of them so far. Rankings are not
        shown anywhere yet, because review collection has not opened.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8">
    <GateNote gate={gate} />

    <ul class="grid gap-4 md:grid-cols-2">
      {
        topLevel.map((c) => {
          const children = childrenOf(c.slug).filter((child) => child.departmentSlug === dept.slug);
          const n = productCount(c.slug);
          return (
            <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-card">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-base font-semibold text-slate-900">
                  <a href={`/software/${c.slug}`} class="hover:text-brand-700">
                    {c.name}
                  </a>
                </h2>
                <span class="flex gap-2">
                  {n > 0 && <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-800">{n} products</span>}
                  {c.wave === 1 && <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs text-amber-900">Opening first</span>}
                </span>
              </div>
              <p class="mt-1 text-sm text-slate-500">Also searched as {c.aliases.join(', ')}</p>
              {children.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                  {children.map((child) => (
                    <li>
                      <a href={`/software/${child.slug}`} class="text-brand-700 hover:underline">
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
      {
        crossDepartment.map((c) => (
          <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-card">
            <h2 class="text-base font-semibold text-slate-900">
              <a href={`/software/${c.slug}`} class="hover:text-brand-700">
                {c.name}
              </a>
            </h2>
            <p class="mt-1 text-sm text-slate-500">Also searched as {c.aliases.join(', ')}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
