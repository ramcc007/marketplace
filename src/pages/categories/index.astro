---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories, departments, getCategory } from '../../lib/taxonomy';
import { breadcrumbList } from '../../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Categories', path: '/categories' },
];
---

<BaseLayout
  title="All software categories"
  description={`Browse ${categories.length} business software categories across ${departments.length} departments, each with written inclusion criteria.`}
  path="/categories"
  jsonLd={[breadcrumbList(crumbs, site)]}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl font-bold tracking-tight">All software categories</h1>
    <p class="mt-2 max-w-3xl text-slate-600">
      {categories.length} categories in {departments.length} departments. Each category lists the capabilities a product
      needs before it can appear there.
    </p>

    <label for="filter" class="mt-6 block text-sm font-medium text-slate-700">Filter categories</label>
    <input
      id="filter"
      type="search"
      autocomplete="off"
      placeholder="For example payroll, SIEM or help desk"
      class="mt-1 w-full max-w-md rounded border border-slate-300 px-3 py-2 focus:border-teal-700 focus:outline-none"
    />
    <p id="filter-empty" class="mt-4 text-slate-600" hidden>No category matches that search.</p>

    {
      departments.map((dept) => (
        <section class="mt-10" data-dept>
          <h2 class="flex items-baseline gap-3 text-xl font-semibold">
            <a href={`/categories/${dept.slug}`} class="hover:text-teal-700">
              {dept.name}
            </a>
            <span class="text-sm font-normal text-slate-500">{dept.categories.length}</span>
          </h2>
          <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {dept.categories.map((c) => (
              <li data-search={[c.name, ...c.aliases].join(' ').toLowerCase()}>
                <a href={`/software/${c.slug}`} class="text-slate-700 hover:text-teal-700">
                  {c.name}
                </a>
                {c.parentSlug && <span class="text-slate-400"> in {getCategory(c.parentSlug)?.name}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('filter') as HTMLInputElement;
  const empty = document.getElementById('filter-empty') as HTMLElement;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-dept]')];

  input.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let shown = 0;
    for (const section of sections) {
      let visible = 0;
      for (const item of section.querySelectorAll<HTMLElement>('[data-search]')) {
        const match = query === '' || (item.dataset.search ?? '').includes(query);
        item.hidden = !match;
        if (match) visible++;
      }
      section.hidden = visible === 0;
      shown += visible;
    }
    empty.hidden = shown > 0;
  });
</script>
