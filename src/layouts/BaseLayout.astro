---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import type { SeoProps } from '../lib/seo';
import { SITE } from '../config/site';
import MegaMenu from '../components/MegaMenu.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { COMPANY_LINKS as company, FOOTER_LEGAL_LINKS as legalLinks, legalReady } from '../config/legal';

type Props = SeoProps;
const props = Astro.props;
const nav = [
  { href: '/about', label: 'About us' },
  { href: '/leave-a-review', label: 'Leave a review', soon: true },
  { href: '/vendors', label: 'Are you a vendor?' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Consent Mode: analytics stays denied until the visitor accepts in the banner.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem('b2b-analytics') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' });
      } catch (e) {}
      gtag('js', new Date());
    </script>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-MZVWZMXR"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...props} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a href="/" class="mr-2 inline-flex" aria-label={`${SITE.name} home`}>
          <img src="/logo.svg" alt={SITE.name} width="166" height="36" class="h-9 w-auto" />
        </a>
        <nav aria-label="Main" class="flex flex-wrap items-center gap-x-1 text-sm">
          <MegaMenu />
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'inline-flex min-h-10 items-center gap-1.5 rounded-md px-3 font-medium hover:bg-slate-100 hover:text-brand-800',
                  isCurrent(item.href) ? 'bg-brand-50 text-brand-800' : 'text-slate-700',
                ]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.soon && <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-slate-500">Soon</span>}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-2 text-sm">
          <a href="/login" class="inline-flex min-h-10 items-center rounded-md px-3 font-medium text-slate-700 hover:bg-slate-100 hover:text-brand-800">Log in</a>
          <a href="/register" class="inline-flex min-h-10 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white hover:bg-brand-800">Register</a>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 bg-slate-900 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-sm md:grid-cols-[1.6fr_1fr_1fr]">
        <div>
          <p>
            <img src="/logo-light.svg" alt={SITE.name} width="148" height="32" class="h-8 w-auto" loading="lazy" />
          </p>
          <p class="mt-4 max-w-sm leading-relaxed">
            <span class="font-semibold text-white">{SITE.name}</span> helps businesses compare software by category. Every price links to the vendor page it came
            from, a product is listed only when it meets written criteria, and no vendor pays to be listed or ranked.
          </p>
        </div>
        <div>
          <p class="font-semibold text-white">Company</p>
          <ul class="mt-2">
            {
              company.map((link) => (
                <li><a class="inline-block py-1.5 hover:text-white hover:underline" href={link.href}>{link.label}</a></li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white">Legal</p>
          <ul class="mt-2">
            {
              legalReady &&
                legalLinks.map((link) => (
                  <li><a class="inline-block py-1.5 hover:text-white hover:underline" href={link.href}>{link.label}</a></li>
                ))
            }
          </ul>
        </div>
      </div>
    </footer>
    <ConsentBanner />
  </body>
</html>
