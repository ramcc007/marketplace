---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import type { SeoProps } from '../lib/seo';
import { SITE } from '../config/site';
import { departments } from '../lib/taxonomy';

type Props = SeoProps;
const props = Astro.props;
const nav = [
  { href: '/categories', label: 'Categories' },
  { href: '/methodology', label: 'How we rank' },
  { href: '/transparency', label: 'Transparency' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
// The footer links to every department so each one is reachable from every page.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {...props} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="inline-flex" aria-label={`${SITE.name} home`}>
          <img src="/logo.svg" alt={SITE.name} width="166" height="36" class="h-9 w-auto" />
        </a>
        <nav aria-label="Main">
          <ul class="flex flex-wrap items-center gap-x-1 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'inline-flex min-h-10 items-center rounded-md px-3 hover:bg-slate-100 hover:text-brand-800',
                      isCurrent(item.href) ? 'bg-brand-50 font-semibold text-brand-800' : 'text-slate-600',
                    ]}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 bg-slate-900 text-slate-300">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-sm md:grid-cols-[1.2fr_1fr_2fr]">
        <div>
          <p>
            <img src="/logo-light.svg" alt={SITE.name} width="148" height="32" class="h-8 w-auto" loading="lazy" />
          </p>
          <p class="mt-4 max-w-xs leading-relaxed">
            Prices come from each vendor's own pages and link back to them. No vendor pays to be listed or ranked.
          </p>
        </div>
        <div>
          <p class="font-semibold text-white">About</p>
          <ul class="mt-2">
            <li><a class="inline-block py-1.5 hover:text-white hover:underline" href="/categories">All categories</a></li>
            <li><a class="inline-block py-1.5 hover:text-white hover:underline" href="/methodology">How we rank</a></li>
            <li><a class="inline-block py-1.5 hover:text-white hover:underline" href="/transparency">Transparency</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white">Departments</p>
          <ul class="mt-2 grid grid-cols-2 gap-x-4 sm:grid-cols-3">
            {
              departments.map((dept) => (
                <li>
                  <a class="inline-block py-1.5 hover:text-white hover:underline" href={`/categories/${dept.slug}`}>
                    {dept.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
