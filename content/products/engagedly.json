  "facts": [
    {
      "text": "The pricing page lists review templates, 30-60-90 day reviews, 9-box assessment and calibration under the Performance Suite.",
      "sourceUrl": "https://www.engagedly.com/pricing/",
      "checkedAt": "2026-11-04"
    },
    {
      "text": "The page does not say which price in the $5 to $8 range applies to which bundle, and says pricing varies with employee count and bundling.",
      "sourceUrl": "https://www.engagedly.com/pricing/",
      "checkedAt": "2026-11-04"
    },
    {
      "text": "Engagement surveys sit in the Engage & Listen Suite, listed at $2 per user per month, paid annually, with a stated minimum of $7,500 a year.",
      "sourceUrl": "https://www.engagedly.com/pricing/",
      "checkedAt": "2026-11-04"
    },
    {
      "text": "Engagedly requires at least four responses before analytics appear. Admins can raise that threshold but not lower it, and respondent names are hidden in aggregated reports.",
      "sourceUrl": "https://help.engagedly.com/view-and-export-responses",
      "checkedAt": "2026-11-04"
    },
    {
      "text": "Managers can filter responses by team only when the admin allows it.",
      "sourceUrl": "https://help.engagedly.com/view-and-export-responses",
      "checkedAt": "2026-11-04"
    }
