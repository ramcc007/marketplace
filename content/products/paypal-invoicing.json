    { "text": "Customers do not need a PayPal account to pay and can use cards, PayPal, Venmo, Apple Pay, Pay Later or Pay by Bank.", "sourceUrl": "https://www.paypal.com/us/business/accept-payments/invoicing", "checkedAt": "2026-11-04" },
    { "text": "Invoices can be shared as a link, by email or SMS, or as a QR code, and the sender can see when an invoice is sent, opened and paid.", "sourceUrl": "https://www.paypal.com/us/business/accept-payments/invoicing", "checkedAt": "2026-11-04" },
    { "text": "International invoices carry an additional 1.50% on top of the domestic rate, and the fixed fee depends on the currency received.", "sourceUrl": "https://www.paypal.com/us/business/paypal-business-fees", "checkedAt": "2026-11-04" },
    { "text": "PayPal says invoices can sync with QuickBooks and Xero, and that recurring invoices and automatic reminders are available.", "sourceUrl": "https://www.paypal.com/us/business/accept-payments/invoicing", "checkedAt": "2026-11-04" }
